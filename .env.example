# Copy to .env (or run backend/scripts/setup.bat once).
# Loaded automatically when Studio starts — no manual $env: exports needed.

STUDIO_BUILDER_V2=true
# Local MongoDB (MongoDB Compass) — use memory:// for in-memory tests only
STUDIO_MONGO_URI=mongodb://localhost:27017/?directConnection=true
STUDIO_MONGO_DB=dharwin_studio
STUDIO_PORT=8787
STUDIO_S3_MOCK=true
STUDIO_S3_BUCKET=dharwin-studio-dev

# Auth email (Gmail SMTP). Console fallback if SMTP_USERNAME/PASSWORD unset.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_TIMEOUT=7
SMTP_USERNAME=your-smtp-user@example.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-from-address@example.com
APP_BASE_URL=http://localhost:3000
AUTH_JWT_SECRET=change-me

# Optional overrides:
# STUDIO_DATA=C:/path/to/studio/data
