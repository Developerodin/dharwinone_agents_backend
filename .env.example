# Copy to .env (or run backend/scripts/setup.bat once).

# Loaded automatically when Studio starts — no manual $env: exports needed.



# PostgreSQL (Docker: see docker-compose.yml). Use memory:// for in-memory tests only.

STUDIO_DATABASE_URL=postgresql+psycopg://studio:studio@localhost:5432/dharwin_studio

# Prisma reads DATABASE_URL (same DSN, without +psycopg driver suffix)

DATABASE_URL=postgresql://studio:studio@localhost:5432/dharwin_studio

STUDIO_PORT=8787

# Next.js cutover port (npm run dev:8787 / start-all). Default npm run dev still uses 8790 for parallel testing.

NEXT_PORT=8787

STUDIO_S3_MOCK=true

STUDIO_S3_BUCKET=dharwin-studio-dev

# Public asset base URL for rendered HTML <img src> (CDN or bucket URL).

# Example: https://cdn.dharwinone.com or https://<bucket>.s3.amazonaws.com

STUDIO_ASSET_PUBLIC_BASE_URL=

# Real-S3 mode (set STUDIO_S3_MOCK=false in production):

# AWS_REGION=ap-south-1

# AWS_ACCESS_KEY_ID=

# AWS_SECRET_ACCESS_KEY=

# AWS_S3_ENDPOINT_URL=   # optional (S3-compatible providers)



# Auth email (Gmail SMTP). Console fallback if SMTP_USERNAME/PASSWORD unset.

SMTP_HOST=smtp.gmail.com

SMTP_PORT=465

SMTP_TIMEOUT=7

SMTP_USERNAME=your-smtp-user@example.com

SMTP_PASSWORD=your-app-password

EMAIL_FROM=your-from-address@example.com

APP_BASE_URL=http://localhost:3000

AUTH_JWT_SECRET=change-me



# Optional overrides:

# STUDIO_DATA=C:/path/to/studio/data



# Onboarding / edit LLM (set STUDIO_ONBOARDING_LLM=false in tests)

STUDIO_ONBOARDING_LLM=true

STUDIO_ONBOARDING_PROVIDER=openai

STUDIO_ONBOARDING_MODEL=gpt-4o-mini

# STUDIO_ONBOARDING_BASE_URL=https://api.openai.com



# Cloud LLM credentials (production — no Ollama/aider required)

OPENAI_API_KEY=

ANTHROPIC_API_KEY=



# Harness worker LLM stages (cloud-first; auto uses cloud when API keys set)

# STUDIO_IMPLEMENTER=auto

# STUDIO_IMPLEMENTER=cloud

# STUDIO_IMPLEMENTER=aider

STUDIO_HARNESS_PLANNER_PROVIDER=openai

STUDIO_HARNESS_PLANNER_MODEL=gpt-4o-mini

STUDIO_HARNESS_IMPLEMENTER_PROVIDER=openai

STUDIO_HARNESS_IMPLEMENTER_MODEL=gpt-4o

STUDIO_HARNESS_REVIEWER_PROVIDER=openai

STUDIO_HARNESS_REVIEWER_MODEL=gpt-4o-mini



# Tests: skip real LLM/aider subprocess

# STUDIO_FAKE_WORKER=1



# Phase 1 M3 — payments scaffold (disabled by default)

RAZORPAY_ENABLED=false

RAZORPAY_WEBHOOK_SECRET=

# Reconciliation (§10.2): pull recent captured payments from Razorpay when no list is posted.
RAZORPAY_KEY_ID=

RAZORPAY_KEY_SECRET=

# Shared secret for the ops-only reconcile route (x-admin-secret header).
RECONCILE_ADMIN_SECRET=

