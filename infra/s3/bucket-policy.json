{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicReadSiteAssets",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::vsc-files-storage/projects/*",
        "arn:aws:s3:::vsc-files-storage/studio/*"
      ]
    }
  ]
}
