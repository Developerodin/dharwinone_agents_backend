# NOTE: the sidecar reads backend/.env (shared with the studio backend), not a
# local .env. Add these keys there.
PORT=8788
MONGO_URI=mongodb://127.0.0.1:27017/dharwinone

# Copy real values from C:\Users\INTEL\Desktop\DHARWIN NEW\uat.dharwin.backend\.env
TWILIO_AUTH_ID=
TWILIO_AUTH_TOKEN=
TWILIO_API_SID=
TWILIO_API_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_PHONE_NUMBER=
# Public origin Twilio can reach (webhooks + TwiML App Voice URL host)
TWILIO_WEBHOOK_BASE_URL=
TWILIO_VERIFY_WEBHOOKS=true
