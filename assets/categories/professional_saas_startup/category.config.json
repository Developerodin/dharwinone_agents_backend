    "fields": {
      "business_name": {
        "label": "Product or company name",
        "tier": "required",
        "entity_label": "product",
        "followUp": "What's your product or company name? For example, \"Axon\" or \"Securify\"."
      },
      "tagline": {
        "label": "Value proposition",
        "tier": "required",
        "followUp": "What's your one-line value prop? For example, \"Ship secure APIs in minutes, not months\"."
      },
      "country": {
        "label": "Country",
        "tier": "required",
        "followUp": "Which country does your company primarily serve or operate from?"
      },
      "product_type": {
        "label": "Product category",
        "tier": "required",
        "type": "enum",
        "options": [
          "general_saas",
          "cybersecurity",
          "devtools",
          "fintech",
          "hr_tech",
          "marketing_tech"
        ],
        "option_labels": {
          "general_saas": "General SaaS / B2B software",
          "cybersecurity": "Cybersecurity / security product",
          "devtools": "Developer tools / infrastructure",
          "fintech": "Fintech / payments",
          "hr_tech": "HR / people ops software",
          "marketing_tech": "Marketing / growth software"
        },
        "followUp": "What kind of product is this?"
      },
      "services": {
        "label": "Key features",
        "tier": "required",
        "type": "service_picker"
      },
      "service_area": {
        "label": "Target audience",
        "tier": "recommended",
        "type": "tags",
        "followUp": "Who is your ideal customer? For example, \"startups\", \"enterprise security teams\", or \"freelance developers\"."
      },
      "cta_preference": {
        "label": "Primary CTA",
        "tier": "required",
        "type": "enum",
        "options": [
          "demo",
          "trial",
          "form"
        ],
        "option_labels": {
          "demo": "Book a demo",
          "trial": "Start free trial",
          "form": "Contact sales"
        },
        "followUp": "What should the main call-to-action be? Reply with book a demo, start free trial, or contact sales."
      },
      "tone_preference": {
        "label": "Brand tone",
        "tier": "required",
        "type": "enum",
        "options": [
          "professional",
          "technical",
          "friendly",
          "bold",
          "enterprise"
        ],
        "option_labels": {
          "professional": "Professional & trustworthy",
          "technical": "Technical & precise",
          "friendly": "Friendly & approachable",
          "bold": "Bold & disruptive",
          "enterprise": "Enterprise & authoritative"
        },
        "followUp": "What brand tone fits your product? Reply with professional, technical, friendly, bold, or enterprise."
      },
      "email": {
        "label": "Contact email",
        "tier": "recommended",
        "followUp": "What email should prospects use for demos, trials, or sales inquiries?"
      }
    },
